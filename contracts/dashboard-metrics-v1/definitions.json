{
  "version": 1,
  "metrics": [
    {
      "metric_name": "click_through_rate",
      "metric_label": "Click-Through Rate (CTR)",
      "metric_description": "Percentage of impressions that result in clicks",
      "metric_type": "ratio",
      "calculation": "total_ad_clicks / total_ad_impressions",
      "has_filter": false,
      "filter_condition": null,
      "dependent_metrics": "total_ad_clicks, total_ad_impressions",
      "underlying_model": "rpt_ad_performance_daily",
      "metric_time_expression": "date",
      "metric_time_grains": "day, week, month, quarter, year",
      "value_format": "percent"
    },
    {
      "metric_name": "marketing_efficiency_ratio_summary",
      "metric_label": "Marketing Efficiency Ratio (Executive Summary)",
      "metric_description": "Marketing efficiency ratio (net revenue / ad spend) from executive summary data.\nUse this for channel-level MER calculations that can be grouped by sm_channel.",
      "metric_type": "ratio",
      "calculation": "order_net_revenue_summary / total_ad_spend_summary",
      "has_filter": false,
      "filter_condition": null,
      "dependent_metrics": "order_net_revenue_summary, total_ad_spend_summary",
      "underlying_model": "rpt_executive_summary_daily",
      "metric_time_expression": "date",
      "metric_time_grains": "day, week, month, quarter, year",
      "value_format": "ratio"
    },
    {
      "metric_name": "order_count",
      "metric_label": "Order Count",
      "metric_description": "Total number of valid orders",
      "metric_type": "simple",
      "calculation": "COUNT(sm_order_key) WHERE [filter applied]",
      "has_filter": true,
      "filter_condition": "is_order_sm_valid",
      "dependent_metrics": null,
      "underlying_model": "obt_orders",
      "metric_time_expression": "date(coalesce(order_processed_at_local_datetime, order_created_at_local_datetime))",
      "metric_time_grains": "day, week, month, quarter, year",
      "value_format": "count"
    },
    {
      "metric_name": "order_count_summary",
      "metric_label": "Order Count (Executive Summary)",
      "metric_description": "Total order count from executive summary, on the valid sales channels",
      "metric_type": "simple",
      "calculation": "SUM(order_count) WHERE [filter applied]",
      "has_filter": true,
      "filter_condition": "sm_channel in ('online_dtc', 'amazon', 'retail', 'wholesale', 'tiktok_shop')",
      "dependent_metrics": null,
      "underlying_model": "rpt_executive_summary_daily",
      "metric_time_expression": "date",
      "metric_time_grains": "day, week, month, quarter, year",
      "value_format": "count"
    },
    {
      "metric_name": "order_net_revenue",
      "metric_label": "Order Net Revenue",
      "metric_description": "Net revenue after refunds and discounts, excludes invalid orders",
      "metric_type": "simple",
      "calculation": "SUM(order_net_revenue) WHERE [filter applied]",
      "has_filter": true,
      "filter_condition": "is_order_sm_valid",
      "dependent_metrics": null,
      "underlying_model": "obt_orders",
      "metric_time_expression": "date(coalesce(order_processed_at_local_datetime, order_created_at_local_datetime))",
      "metric_time_grains": "day, week, month, quarter, year",
      "value_format": "currency"
    },
    {
      "metric_name": "order_net_revenue_summary",
      "metric_label": "Net Revenue (Executive Summary)",
      "metric_description": "Net revenue from executive summary data, on the valid sales channels",
      "metric_type": "simple",
      "calculation": "SUM(order_net_revenue) WHERE [filter applied]",
      "has_filter": true,
      "filter_condition": "sm_channel in ('online_dtc', 'amazon', 'retail', 'wholesale', 'tiktok_shop')",
      "dependent_metrics": null,
      "underlying_model": "rpt_executive_summary_daily",
      "metric_time_expression": "date",
      "metric_time_grains": "day, week, month, quarter, year",
      "value_format": "currency"
    },
    {
      "metric_name": "platform_cost_per_conversion",
      "metric_label": "Platform Cost Per Conversion",
      "metric_description": "Average cost per platform-reported conversion",
      "metric_type": "ratio",
      "calculation": "total_ad_spend / platform_reported_conversions",
      "has_filter": false,
      "filter_condition": null,
      "dependent_metrics": "total_ad_spend, platform_reported_conversions",
      "underlying_model": "rpt_ad_performance_daily",
      "metric_time_expression": "date",
      "metric_time_grains": "day, week, month, quarter, year",
      "value_format": "currency"
    },
